# Teachart Ninja Build Configuration

# Variables
python = python
pyside6_rcc = pyside6-rcc
pyside6_linguist = pyside6-linguist
pyside6_lupdate = pyside6-lupdate
pyside6_lrelease = pyside6-lrelease

# Rules
rule run_python
  command = $python $in $args
  description = Running Python: $desc

rule pyside_rcc
  command = cmd /c "$pyside6_rcc $in -g python | $python -c "import sys; print(sys.stdin.read().replace('PySide6','PyQt6'),end='')" > $out"
  description = Compiling Qt resources: $in -> $out

# ADD: Get-ChildItem designer\*.ui | ForEach-Object { pyuic6 $_.FullName -o "source\ui\$($_.BaseName).py" } 

rule compress_qss
  command = $python build/qss_to_py.py $name $in
  description = Compressing QSS: $name

rule pack_theme
  command = $python theming/tpack.py $args
  description = $desc

rule qt_tool
  command = $cmd
  description = $desc

rule uv
  command = uv $args
  description = $desc

# Build executable script
build setup: uv
  args = pip install -e .
  desc = Buildung teachart and tpack

# Compile resources
build source/styling/resources/stylesheets-light: compress_qss resources/themes/light/light.qss
  name = light

build source/styling/resources/stylesheets-dark: compress_qss resources/themes/dark/dark.qss
  name = dark

build source/styling/resources/light.py: pyside_rcc resources/themes/light/light.qrc

build source/styling/resources/dark.py: pyside_rcc resources/themes/dark/dark.qrc

build source/styling/resources/common.py: pyside_rcc resources/resources.qrc

build compile-common: phony source/styling/resources/common.py

build compile-light: phony source/styling/resources/light.py source/styling/resources/stylesheets-light

build compile-dark: phony source/styling/resources/dark.py source/styling/resources/stylesheets-dark

build compile-all: phony compile-common compile-light compile-dark

# Pack themes - light
build resources/themes/light/resources.bin: pack_theme source/styling/resources/light.py
  args = bin resources/themes/light/resources.bin source/styling/resources/light.py
  desc = Packing light theme resources

build resources/themes/packed/light.taste: pack_theme resources/themes/light/resources.bin resources/themes/light/properties.json resources/themes/light/light.qss
  args = pack resources/themes/packed/light.taste resources/themes/light/properties.json resources/themes/light/resources.bin resources/themes/light/light.qss
  desc = Creating light.taste package

build pack-light: phony resources/themes/packed/light.taste

# Pack themes - dark
build resources/themes/dark/resources.bin: pack_theme source/styling/resources/dark.py
  args = bin resources/themes/dark/resources.bin source/styling/resources/dark.py
  desc = Packing dark theme resources

build resources/themes/packed/dark.taste: pack_theme resources/themes/dark/resources.bin resources/themes/dark/properties.json resources/themes/dark/dark.qss
  args = pack resources/themes/packed/dark.taste resources/themes/dark/properties.json resources/themes/dark/resources.bin resources/themes/dark/dark.qss
  desc = Creating dark.taste package

build pack-dark: phony resources/themes/packed/dark.taste

build pack-all: phony pack-light pack-dark

build build-res: phony compile-all pack-all

# Qt Toolchain
build linguist-de: qt_tool
  cmd = $pyside6_linguist translations/de.ts
  desc = Opening Qt Linguist for German translations

build lupdate: qt_tool
  cmd = $pyside6_lupdate source/ -ts translations/de.ts
  desc = Updating translation files

build lrelease: qt_tool translations/compiled/de.qm
  cmd = $pyside6_lrelease translations/de.ts -qm translations/compiled/de.qm
  desc = Compiling translations

build translations/compiled/de.qm: qt_tool translations/de.ts
  cmd = $pyside6_lrelease translations/de.ts -qm translations/compiled/de.qm
  desc = Compiling German translations

# Default target
default build-res

# Convenience phony targets
build all: phony build-res test

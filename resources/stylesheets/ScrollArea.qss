QScrollArea {
    background-color: #ffffff;
}

QScrollBar:vertical {
    border: 0px solid grey;
    background: none;
    max-width: 15px;
    margin: 20px 0px 20px 0px;
}

QScrollBar:handle:vertical {
    background: #e4e4e4;
    min-width: 15px;
}

QScrollBar:horizontal {
    border: 0px solid grey;
    background: none;
    max-height: 15px;
    margin: 0px 20px 0px 20px;
}

QScrollBar:handle:horizontal {
    background: #e4e4e4;
    min-width: 15px;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    width: 19px;
    height: 19px;
    background: none;

}

QScrollBar::up-arrow {
    image: url(icons:ic_arrowup.svg);
    background: none;
}

QScrollBar::up-arrow:pressed {
    image: url(icons:ic_arrowup.svg);
    width: 10px;
    height: 10px;
}

QScrollBar::down-arrow {
    image: url(icons:ic_arrowdown.svg);
    background: none;
}

QScrollBar::down-arrow:pressed {
    image: url(icons:ic_arrowdown.svg);
    width: 10px;
    height: 10px;
}

QScrollBar::right-arrow {
    image: url(icons:ic_arrowrigeduc.svg);
    background: none;
}

QScrollBar::right-arrow:pressed {
    image: url(icons:ic_arrowrigeduc.svg);
    width: 10px;
    height: 10px;
}

QScrollBar::left-arrow {
    image: url(icons:ic_arrowleft.svg);
    background: none;
}

QScrollBar::left-arrow:pressed {
    image: url(icons:ic_arrowleft.svg);
    width: 10px;
    height: 10px;
}

QScrollBar::add-line:vertical {
    border: 0px solid grey;
    background: none;
    height: 19px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
} 

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical, QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: white;
} 

QScrollBar::sub-line:vertical {
    border: 0px solid grey;
    background: none;
    height: 19px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal {
    border: 0px solid grey;
    background: none;
    width: 19px;
    subcontrol-position: right;
    subcontrol-origin: margin;
} 

QScrollBar::sub-line:horizontal {
    border: 0px solid grey;
    background: none;
    width: 19px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
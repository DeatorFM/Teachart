
QWidget {
    background: rgba(248, 249, 250, 255);
    color: rgba(77, 81, 87, 255);
    selection-color:rgba(77, 81, 87, 255);
    selection-background-color:rgba(26, 115, 232, 128)
    }

QWidget:disabled {
    color:rgba(77, 81, 87, 102);
    selection-background-color:rgba(77, 81, 87, 64);
    selection-color:rgba(77, 81, 87, 102)
    }
    
QWidget:focus {
    outline:none
    }
    
QCheckBox:!window,

QRadioButton:!window,

QPushButton:!window,

QLabel:!window,

QLCDNumber:!window {
    background:transparent
    }

QMdiSubWindow > QCheckBox:!window,
QMdiSubWindow > QRadioButton:!window,
QMdiSubWindow > QPushButton:!window,
QMdiSubWindow > QLabel:!window,
QMdiSubWindow > QLCDNumber:!window {
    background: rgba(248, 249, 250, 255)
    }
    
QMainWindow::separator {
    width:4px;
    height:4px;
    background: rgba(218, 220, 224, 255)
    }
    
QMainWindow::separator:hover,
QMainWindow::separator:pressed {
    background: rgba(26, 115, 232, 255)
    }
    
QToolTip {
    background: rgba(248, 249, 250, 255);
    color: rgba(77, 81, 87, 255)
    }
    
QSizeGrip {
    width:0;
    height:0;
    image:none
    }

QStatusBar {
    background: rgba(223, 225, 229, 255)
    }
    
QStatusBar::item {
    border:none
    }

QStatusBar QWidget {
    background:transparent;
    padding:3px;
    border-radius:round 4px
    }
    
QStatusBar > .QSizeGrip {
    padding:0
    }
    
QStatusBar QWidget:hover {
    background: rgba(0, 0, 0, 21)
    }
    
QStatusBar QWidget:pressed,QStatusBar QWidget:checked {
    background:rgba(0, 0, 0, 36)
    }
    
QCheckBox,QRadioButton {
    border-top:2px solid transparent;
    border-bottom:2px solid transparent
    }
    
QCheckBox:hover,QRadioButton:hover {
    border-bottom:2px solid rgba(26, 115, 232, 255)
    }
    
QGroupBox {
    font-weight:bold;
    margin-top:8px;
    padding:2px 1px 1px 1px;
    border-radius:round 4px;
    border:1px solid rgba(218, 220, 224, 255)
    }
    
QGroupBox::title {
    subcontrol-origin:margin;
    subcontrol-position:top left;
    left:7px;
    margin:0 2px 0 3px
    }
    
QGroupBox:flat {
    border-color:transparent
    }

QMenuBar {
    padding:2px;
    border-bottom:1px solid rgba(218, 220, 224, 255);
    background: rgba(248, 249, 250, 255)
    }
    
QMenuBar::item {
    background:transparent;
    padding:4px
    }
    
QMenuBar::item:selected {
    padding:4px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 32)
    }
    
QMenuBar::item:pressed {
    padding:4px;
    margin-bottom:0;
    padding-bottom:0
    }
    
QToolBar {
    padding:1px;
    font-weight:bold;
    spacing:2px;
    margin:1px;
    background: rgba(235, 235, 235, 255);
    border-style:none
    }
    
QToolBar::handle:horizontal {
    width:20px;
    image: url(:/theme/drag_indicator_#4d5157ff_0.svg)
    }
    
QToolBar::handle:vertical {
    height:20px;
    image: url(:/theme/drag_indicator_#4d5157ff_90.svg)
    }
    
QToolBar::handle:horizontal:disabled {
    image: url(:/theme/drag_indicator_#4d515766_0.svg)
    }
    
QToolBar::handle:vertical:disabled {
    image: url(:/theme/drag_indicator_#4d515766_90.svg)
    }
    
QToolBar::separator {
    background: rgba(218, 220, 224, 255);
    }
    
QToolBar::separator:horizontal {
    width:2px;
    margin:0 6px
    }
    
QToolBar::separator:vertical {
    height:2px;
    margin:6px 0
    }
    
QToolBar > QToolButton {
    background:transparent;
    padding:3px;
    border-radius: 4px
    }
    
QToolBar > QToolButton:hover,QToolBar > QToolButton::menu-button:hover {
    background: rgba(0, 0, 0, 21);
    }
    
QToolBar > QToolButton::menu-button {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px
    }
    
QToolBar > QToolButton:pressed,QToolBar > QToolButton::menu-button:pressed:enabled,QToolBar > QToolButton:checked:enabled {
    background: rgba(0, 0, 0, 36);
    }
    
QToolBar > QWidget {
    background:transparent
    }
    
QMenu {
    background: rgba(248, 249, 250, 255);
    padding:8px 0
    }
    
QMenu::separator {
    margin:4px 0;
    height:1px;
    background: rgba(218, 220, 224, 255);
    }
    
QMenu::item {
    padding:4px 19px
    }
    
QMenu::item:selected {
    background: rgba(0, 0, 0, 34)
    }
    
QMenu::icon {
    padding-left:10px;
    width:14px;
    height:14px
    }
    
QMenu::right-arrow {
    margin:2px;
    padding-left:12px;
    height:20px;
    width:20px;
    image: url(:/theme/chevron_right_#4d5157ff_0.svg)
    }
    
QMenu::right-arrow:disabled {
    image: url(:/theme/chevron_right_#4d515766_0.svg)
    }
    
QScrollBar {
    background: rgba(0, 0, 0, 16);
    border-radius: 4px;
    
    }
    
QScrollBar:horizontal {
    
    }
    
QScrollBar:vertical {
    
    }
    
QScrollBar::handle {
    background: rgba(0, 0, 0, 64);
    border-radius:3px
    }
    
QScrollBar::handle:hover {
    background: rgba(0, 0, 0, 80)
    }
    
QScrollBar::handle:pressed {
    background: rgba(0, 0, 0, 96)
    }
    
QScrollBar::handle:disabled {
    background: rgba(0, 0, 0, 21)
    }
    
QScrollBar::handle:horizontal {
    min-width:8px;
    
    }
    
QScrollBar::handle:horizontal:hover {
    
    }
    
QScrollBar::handle:vertical {
    min-height:8px;
    
    }
    
QScrollBar::handle:vertical:hover {
    
    }
    
QScrollBar::sub-page,QScrollBar::add-page {
    background:transparent
    }
    
QScrollBar::sub-line,QScrollBar::add-line {
    background:transparent;
    
    }
    
QScrollBar::up-arrow:enabled {
    image: url(:/theme/arrow_drop_up_#00000040_0.svg)
    }
    
QScrollBar::right-arrow:enabled {
    image: url(:/theme/arrow_drop_up_#00000040_90.svg)
    }
    
QScrollBar::down-arrow:enabled {
    image: url(:/theme/arrow_drop_up_#00000040_180.svg)
    }
    
QScrollBar::left-arrow:enabled {
    image:url(:/theme/arrow_drop_up_#00000040_270.svg)
    }
    
QScrollBar::up-arrow:hover {
    image: url(:/theme/arrow_drop_up_#00000060_0.svg)
    }
    
QScrollBar::right-arrow:hover {
    image: url(:/theme/arrow_drop_up_#00000060_90.svg)
    }
    
QScrollBar::down-arrow:hover {
    image: url(:/theme/arrow_drop_up_#00000060_180.svg)
    }
    
QScrollBar::left-arrow:hover {
    image: url(:/theme/arrow_drop_up_#00000060_270.svg)
    }
    
QProgressBar {
    text-align:center;
    border:1px solid rgba(218, 220, 224, 255);
    border-radius:4px
    }
    
QProgressBar::chunk {
    background: rgba(26, 115, 232, 255);
    border-radius:3px
    }
    
QProgressBar::chunk:disabled {
    background: rgba(77, 81, 87, 64)
    }
    
QPushButton {
    color: rgba(26, 115, 232, 255);
    border:1px solid rgba(218, 220, 224, 255);
    padding:4px 8px;
    border-radius:4px
    }
    
QPushButton:flat,QPushButton:default {
    border:none;
    padding:5px 9px
    }
    
QPushButton:default {
    color:rgba(248, 249, 250, 255);
    background:rgba(26, 115, 232, 255)
    }
    
QPushButton:hover {
    background: rgba(26, 115, 232, 26)
    }
    
QPushButton:pressed {
    background: rgba(26, 115, 232, 61)
    }
    
QPushButton:checked:enabled {
    background:rgba(26, 115, 232, 61)
    }
    
QPushButton:default:hover {
    background: rgba(26, 115, 232, 255)
    }
    
QPushButton:default:pressed,QPushButton:default:checked {
    background:rgba(26, 115, 232, 255)
    }
    
QPushButton:default:disabled,QPushButton:default:checked:disabled {
    background: rgba(77, 81, 87, 64)
    }
    
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons:0
    }
    
QDialogButtonBox QPushButton {
    min-width:65px
    }
    
QToolButton {
    background:transparent;
    padding:5px;
    spacing:2px;
    border-radius:2px
    }
    
QToolButton:hover,QToolButton::menu-button:hover {
    background: rgba(26, 115, 232, 26)
    }
    
QToolButton:pressed,QToolButton:checked:pressed,QToolButton::menu-button:pressed:enabled {
    background: rgba(26, 115, 232, 61)
    }
    
QToolButton:selected:enabled,QToolButton:checked:enabled {
    background: rgba(26, 115, 232, 61)
    }
    
QToolButton::menu-indicator {
    height:18px;
    width:18px;
    top:6px;
    left:3px;
    image: url(:/theme/expand_less_#4d5157ff_180.svg)
    }
    
QToolButton::menu-indicator:disabled {
    image: url(:/theme/expand_less_#4d515766_180.svg)
    }
    
QToolButton::menu-arrow {
    image:unset
    }

QToolButton::menu-button {
    subcontrol-origin:margin;
    width:17px;
    border-top-right-radius:2px;
    border-bottom-right-radius:2px;
    image: url(:/theme/expand_less_#4d5157ff_180.svg)
    }
    
QToolButton::menu-button:disabled {
    image: url(:/theme/expand_less_#4d515766_180.svg)
    }
    
QToolButton[popupMode=MenuButtonPopup] {
    padding-right:1px;
    margin-right:18px;
    border-top-right-radius:0;
    border-bottom-right-radius:0
    }
    
QComboBox {
    min-height:1.5em;
    padding:0 8px 0 4px;
    background:rgba(248, 249, 250, 255);
    border:1px solid rgba(218, 220, 224, 255);
    border-radius:4px
    }
    
QComboBox:focus,QComboBox:open {
    border-color:rgba(26, 115, 232, 255)
    }
    
QComboBox::drop-down {
    margin:2px 2px 2px -6px;
    border-radius:round 4
    }
    
QComboBox::drop-down:editable:hover {
    background:rgba(0, 0, 0, 24)
    }
    
QComboBox::down-arrow {
    image: url(:/theme/expand_less_#4d5157ff_180.svg)
    }
    
QComboBox::down-arrow:disabled {
    image: url(:/theme/expand_less_#4d515766_180.svg)
    }
    
QComboBox::down-arrow:editable:open {
    image: url(:/theme/expand_less_#4d5157ff_0.svg)
    }
    
QComboBox::down-arrow:editable:open:disabled {
    image: url(:/theme/expand_less_#4d515766_0.svg)
    }
    
QComboBox::item:selected {
    border:none;
    background: rgba(26, 115, 232, 89);
    border-radius:4px
    }
    
QComboBox QListView[frameShape="NoFrame"] {
    margin:0;
    padding:4px;
    background: rgba(248, 249, 250, 255);
     
    }
    
QComboBox QListView::item {
    border-radius:4px
    }
    
QSlider {
    padding:2px 0
    }
    
QSlider::groove {
    border-radius:2px
    }
    
QSlider::groove:horizontal {
    height:4px
    }
    
QSlider::groove:vertical {
    width:4px
    }
    
QSlider::sub-page:horizontal,QSlider::add-page:vertical,QSlider::handle {
    background: rgba(26, 115, 232, 255)
    }
    
QSlider::sub-page:horizontal:disabled,QSlider::add-page:vertical:disabled,QSlider::handle:disabled {
    background: rgba(77, 81, 87, 64)
    }
    
QSlider::add-page:horizontal,QSlider::sub-page:vertical {
    background: rgba(77, 81, 87, 51)
    }
    
QSlider::handle:hover,QSlider::handle:pressed {
    background: rgba(26, 115, 232, 255)
    }
    
QSlider::handle:horizontal {
    width:16px;
    height:8px;
    margin:-6px 0;
    border-radius:8px
    }
    
QSlider::handle:vertical {
    width:8px;
    height:16px;
    margin:0 -6px;
    border-radius:8px
    }
    
QTabWidget::pane {
    border:1px solid rgba(218, 220, 224, 255);
    border-radius:4px
    }
    
QTabBar {
    qproperty-drawBase:0
    }
    
QTabBar::close-button {
    image:url(:/theme/close_#4d5157ff_0.svg)
    }
    
QTabBar::close-button:hover {
    background: rgba(0, 0, 0, 32);
    border-radius:4px
    }
    
QTabBar::close-button:!selected {
    image:url(:/theme/close_#4d515799_0.svg)
    }
    
QTabBar::close-button:disabled {
    image:url(:/theme/close_#4d515766_0.svg)
    }
    
QTabBar::tab {
    padding:3px;
    border-style:solid}

QTabBar::tab:hover,QTabBar::tab:selected:hover:enabled {
    background:rgba(0, 0, 0, 21)
    }

QTabBar::tab:selected:enabled {
    color:rgba(26, 115, 232, 255);
    background:rgba(0, 0, 0, 0);
    border-color:rgba(26, 115, 232, 255)
    }

QTabBar::tab:selected:disabled,QTabBar::tab:only-one:selected:enabled {
    border-color:rgba(218, 220, 224, 255)
    }

QTabBar::tab:top {
    border-bottom-width:2px;
    margin:3px 6px 0 0;
    border-top-left-radius:2px;
    border-top-right-radius:2px
    }

QTabBar::tab:bottom {
    border-top-width:2px;
    margin:0 6px 3px 0;
    border-bottom-left-radius:2px;
    border-bottom-right-radius:2px
    }

QTabBar::tab:left {
    border-right-width:2px;
    margin:0 0 6px 3px;
    border-top-left-radius:2px;
    border-bottom-left-radius:2px
    }

QTabBar::tab:right {
    border-left-width:2px;
    margin-bottom:6px;
    margin:0 3px 6px 0;
    border-top-right-radius:2px;
    border-bottom-right-radius:2px
    }

QTabBar::tab:top:first,QTabBar::tab:top:only-one,QTabBar::tab:bottom:first,QTabBar::tab:bottom:only-one {
    margin-left:2px
    }

QTabBar::tab:top:last,QTabBar::tab:top:only-one,QTabBar::tab:bottom:last,QTabBar::tab:bottom:only-one {
    margin-right:2px
    }

QTabBar::tab:left:first,QTabBar::tab:left:only-one,QTabBar::tab:right:first,QTabBar::tab:right:only-one {
    margin-top:2px
    }

QTabBar::tab:left:last,QTabBar::tab:left:only-one,QTabBar::tab:right:last,QTabBar::tab:right:only-one {
    margin-bottom:2px
    }

QDockWidget {
    border:1px solid rgba(218, 220, 224, 255);
    border-radius:4px
    }

QDockWidget::title {
    padding:3px;
    spacing:4px;
    background:rgba(248, 249, 250, 255)
    }

QDockWidget::close-button,QDockWidget::float-button {
    border-radius:2px
    }

QDockWidget::close-button:hover,QDockWidget::float-button:hover {
    background:rgba(26, 115, 232, 26)
    }

QDockWidget::close-button:pressed,QDockWidget::float-button:pressed {
    background:rgba(26, 115, 232, 61)
    }

QFrame {
    border:1px solid rgba(218, 220, 224, 255);
    padding:1px;
    border-radius:4px
    }
    
.QFrame {
    padding:0
    }

    
QFrame[frameShape=NoFrame] {
    border-color:transparent;
    padding:0
    }
    
.QFrame[frameShape=NoFrame] {
    border:none
    }

QFrame[frameShape=Panel] {
    border-color:rgba(248, 249, 250, 255);
    background:rgba(248, 249, 250, 255)
    }

QFrame[frameShape=HLine] {
    max-height:2px;
    border:none;
    background:rgba(218, 220, 224, 255)
    }

QFrame[frameShape=VLine] {
    max-width:2px;
    border:none;
    background:rgba(218, 220, 224, 255)
    }

QLCDNumber {
    min-width:2em;
    margin:2px
    }

QToolBox::tab {
    background:rgba(248, 249, 250, 255);
    border-bottom:2px solid rgba(218, 220, 224, 255);
    border-top-left-radius:4px;
    border-top-right-radius:4px
    }

QToolBox::tab:selected:enabled {
    border-bottom-color:rgba(26, 115, 232, 255)
    }

QSplitter::handle {
    background:rgba(218, 220, 224, 255);
    margin:1px 3px
    }

QSplitter::handle:hover {
    background:rgba(26, 115, 232, 255)
    }

QSplitter::handle:horizontal {
    width:5px;
    image:url(:/theme/horizontal_rule_#4d5157ff_90.svg)
    }

QSplitter::handle:horizontal:disabled {
    image:url(:/theme/horizontal_rule_#4d515766_90.svg)
    }

QSplitter::handle:vertical {
    height:5px;
    image:url(:/theme/horizontal_rule_#4d5157ff_0.svg)
    }

QSplitter::handle:vertical:disabled {
    image:url(:/theme/horizontal_rule_#4d515766_0.svg)
    }

QSplitterHandle::item:hover {
    }

QAbstractScrollArea {
    margin:1px
    }

QAbstractScrollArea::corner {
    background:transparent
    }

QAbstractScrollArea > .QWidget {
    background:transparent
    }

QAbstractScrollArea > .QWidget > .QWidget {
    background:transparent
    }

QMdiArea {
    qproperty-background:rgba(248, 249, 250, 255);
    border-radius:0
    }

QMdiSubWindow {
    background:rgba(248, 249, 250, 255);
    border:1px solid;
    padding:0 3px
    }

QMdiSubWindow > QWidget {
    border:1px solid rgba(218, 220, 224, 255)
    }

QTextEdit, QPlainTextEdit {
    background:rgba(248, 249, 250, 255)
    }

QTextEdit:focus,QTextEdit:selected,QPlainTextEdit:focus,QPlainTextEdit:selected {
    border:1px solid rgba(26, 115, 232, 255);
    selection-background-color:rgba(26, 115, 232, 128)
    }

QTextEdit:!focus,QPlainTextEdit:!focus {
    selection-background-color:rgba(0, 0, 0, 21)
    }


QAbstractItemView {
    padding:0;
    alternate-background-color:transparent;
    selection-background-color:transparent
    }

QAbstractItemView:disabled {
    selection-background-color:transparent
    }

QAbstractItemView::item:alternate,QAbstractItemView::branch:alternate {
    background:rgba(0, 0, 0, 9)
    }

QAbstractItemView::item:selected,QAbstractItemView::branch:selected {
    background:rgba(26, 115, 232, 89)
    }

QAbstractItemView::item:selected:!active,QAbstractItemView::branch:selected:!active {
    background:rgba(26, 115, 232, 23)
    }

QAbstractItemView QLineEdit,QAbstractItemView QAbstractSpinBox,QAbstractItemView QAbstractButton {
    padding:0;
    margin:1px
    }

QListView {
    padding:1px
    }

QListView,QTreeView {
    background:rgba(248, 249, 250, 255)
    }

QListView::item:!selected:hover,QTreeView::item:!selected:hover,QTreeView::branch:!selected:hover {
    background:rgba(0, 0, 0, 19)
    }

QTreeView::branch:!selected:hover,QTreeView::branch:alternate,QTreeView::branch:selected,QTreeView::branch:selected:!active {
    background:transparent
    }

QTreeView::branch {
    border-image:url(:/theme/vertical_line_#00000030_0.svg) 0
    }

QTreeView::branch:active {
    border-image:url(:/theme/vertical_line_#00000050_0.svg) 0
    }

QTreeView::branch:has-siblings:adjoins-item,QTreeView::branch:!has-children:!has-siblings:adjoins-item {
    border-image:unset
    }

QTreeView::branch:has-children:!has-siblings:closed,QTreeView::branch:closed:has-children:has-siblings {
    border-image:unset;
    image:url(:/theme/chevron_right_#4d5157ff_0.svg)
    }

QTreeView::branch:has-children:!has-siblings:closed:disabled,QTreeView::branch:closed:has-children:has-siblings:disabled {
    image:url(:/theme/chevron_right_#4d515766_0.svg)
    }

QTreeView::branch:open:has-children:!has-siblings,QTreeView::branch:open:has-children:has-siblings {
    border-image:unset;
    image:url(:/theme/expand_less_#4d5157ff_180.svg)
    }

QTreeView::branch:open:has-children:!has-siblings:disabled,QTreeView::branch:open:has-children:has-siblings:disabled {
    image:url(:/theme/expand_less_#4d515766_180.svg)
    }

QTreeView > QHeaderView {
    background:rgba(248, 249, 250, 255)
    }

QTreeView > QHeaderView::section {
    background:rgba(218, 220, 224, 255)
    }

QListView::left-arrow {
    margin:-2px;
    image:url(:/theme/chevron_right_#4d515799_180.svg)
    }

QListView::right-arrow {
    margin:-2px;
    image:url(:/theme/chevron_right_#4d515799_180.svg)
    }

QListView::left-arrow:selected:enabled {
    image:url(:/theme/chevron_right_#4d5157ff_180.svg)
    }

QListView::right-arrow:selected:enabled {
    image:url(:/theme/chevron_right_#4d5157ff_0.svg)
    }

QListView::left-arrow:disabled {
    image:url(:/theme/chevron_right_#4d515766_180.svg)
    }

QListView::right-arrow:disabled {
    image:url(:/theme/chevron_right_#4d515766_0.svg)
    }

QColumnView {
    background:rgba(248, 249, 250, 255)
    }

QColumnViewGrip {
    margin:-4px;
    background:rgba(248, 249, 250, 255);
    image:url(:/theme/drag_handle_#4d5157ff_90.svg)
    }

QColumnViewGrip:disabled {
    image:url(:/theme/drag_handle_#4d515766_90.svg)
    }

QTableView {
    gridline-color:rgba(218, 220, 224, 255);
    background:rgba(255, 255, 255, 255);
    selection-background-color:rgba(26, 115, 232, 128);
    alternate-background-color:rgba(0, 0, 0, 18)
    }

QTableView QTableCornerButton::section {
    margin:0 1px 1px 0;
    background:rgba(218, 220, 224, 255);
    border-top-left-radius:2px
    }

QTableView QTableCornerButton::section:pressed {
    background:rgba(26, 115, 232, 128)
    }

QTableView > QHeaderView {
    background:rgba(248, 249, 250, 255);
    border-radius:round 3px
    }

QTableView > QHeaderView::section {
    background:rgba(218, 220, 224, 255)
    }

QHeaderView {
    margin:0;
    border:none
    }

QHeaderView::section {
    border:none;
    background:rgba(218, 220, 224, 255);
    padding-left:4px
    }

QHeaderView::section:horizontal {
    margin-right:1px
    }

QHeaderView::section:vertical {
    margin-bottom:1px
    }

QHeaderView::section:on:enabled,QHeaderView::section:on:pressed {
    color:rgba(26, 115, 232, 255)
    }

QHeaderView::section:last,QHeaderView::section:only-one {
    margin:0
    }

QHeaderView::down-arrow:horizontal {
    margin-left:-19px;
    subcontrol-position:center right;
    image:url(:/theme/expand_less_#4d5157ff_180.svg)
    }

QHeaderView::down-arrow:horizontal:disabled {
    image:url(:/theme/expand_less_#4d515766_180.svg)
    }

QHeaderView::up-arrow:horizontal {
    margin-left:-19px;
    subcontrol-position:center right;
    image:url(:/theme/expand_less_#4d5157ff_0.svg)
    }

QHeaderView::up-arrow:horizontal:disabled {
    image:url(:/theme/expand_less_#4d515766_0.svg)
    }

QHeaderView::down-arrow:vertical,QHeaderView::up-arrow:vertical {
    width:0;
    height:0
    }

QCalendarWidget > .QWidget {
    background:rgba(248, 249, 250, 255);
    border-bottom:1px solid rgba(218, 220, 224, 255);
    border-top-left-radius:round 4px;
    border-top-right-radius:round 4px
    }

QCalendarWidget > .QWidget > QWidget {
    padding:1px
    }

QCalendarWidget .QWidget > QToolButton {
    border-radius:4px
    }

QCalendarWidget > QTableView {
    margin:0;
    border:none;
    border-radius:4px;
    border-top-left-radius:0;
    border-top-right-radius:0;
    alternate-background-color:rgba(0, 0, 0, 18);
    }

QLineEdit,QAbstractSpinBox {
    padding:3px 4px;
    min-height:1em;
    border:1px solid rgba(218, 220, 224, 255);
    background:rgba(248, 249, 250, 255);
    border-radius:4px
    }

QLineEdit:focus,QAbstractSpinBox:focus {
    border-color:rgba(26, 115, 232, 255)
    }

QAbstractSpinBox::up-button,QAbstractSpinBox::down-button {
    subcontrol-position:center right;
    border-radius:round 4px
    }

QAbstractSpinBox::up-button:hover:on,QAbstractSpinBox::down-button:hover:on {
    background:rgba(0, 0, 0, 24)
    }

QAbstractSpinBox::up-button {
    bottom:5px;
    right:4px
    }

QAbstractSpinBox::up-arrow:on {
    image:url(:/theme/arrow_drop_up_#4d5157ff_0.svg)
    }

QAbstractSpinBox::up-arrow:disabled,QAbstractSpinBox::up-arrow:off {
    image:url(:/theme/arrow_drop_up_#4d515766_0.svg)
    }

QAbstractSpinBox::down-button {
    top:5px;
    right:4px
    }

QAbstractSpinBox::down-arrow:on {
    image:url(:/theme/arrow_drop_up_#4d5157ff_180.svg)
    }

QAbstractSpinBox::down-arrow:disabled,QAbstractSpinBox::down-arrow:off {
    image:url(:/theme/arrow_drop_up_#4d515766_180.svg)
    }

QDateTimeEdit::drop-down {
    padding-right:4px;
    width:16px;
    image:url(:/theme/calendar_today_#4d5157ff_0.svg)
    }

QDateTimeEdit::drop-down:disabled {
    image:url(:/theme/calendar_today_#4d515766_0.svg)
    }

QDateTimeEdit::down-arrow[calendarPopup=true] {
    image:none
    }

QFileDialog QFrame {
    border:none
    }

QFontDialog QListView {
    min-height:60px
    }

QComboBox::indicator,QMenu::indicator {
    width:18px;
    height:18px
    }

QMenu::indicator {
    background:rgba(0, 0, 0, 25);
    margin-left:3px;
    border-radius:round 4px
    }

QComboBox::indicator:checked,QMenu::indicator:checked {
    image:url(:/theme/check_#4d5157ff_0.svg)
    }

QCheckBox,QRadioButton {
    spacing:8px
    }

QGroupBox::title,QAbstractItemView::item {
    spacing:6px
    }

QCheckBox::indicator,QGroupBox::indicator,QAbstractItemView::indicator,QRadioButton::indicator {
    height:18px;
    width:18px
    }

QCheckBox::indicator,QGroupBox::indicator,QAbstractItemView::indicator {
    image:url(:/theme/check_box_outline_blank_#4d5157ff_0.svg)
    }

QCheckBox::indicator:unchecked:disabled,QGroupBox::indicator:unchecked:disabled,QAbstractItemView::indicator:unchecked:disabled {
    image:url(:/theme/check_box_outline_blank_#4d515766_0.svg)
    }

QCheckBox::indicator:checked,QGroupBox::indicator:checked,QAbstractItemView::indicator:checked {
    image:url(:/theme/check_box_#1a73e8ff_0.svg)
    }

QCheckBox::indicator:checked:disabled,QGroupBox::indicator:checked:disabled,QAbstractItemView::indicator:checked:disabled {
    image:url(:/theme/check_box_#4d515766_0.svg)
    }

QCheckBox::indicator:indeterminate,QAbstractItemView::indicator:indeterminate {
    image:url(:/theme/indeterminate_check_box_#1a73e8ff_0.svg)
    }

QCheckBox::indicator:indeterminate:disabled,QAbstractItemView::indicator:indeterminate:disabled {
    image:url(:/theme/indeterminate_check_box_#4d515766_0.svg)
    }

QRadioButton::indicator:unchecked {
    image:url(:/theme/radio_button_unchecked_#4d5157ff_0.svg)
    }

QRadioButton::indicator:unchecked:disabled {
    image:url(:/theme/radio_button_unchecked_#4d515766_0.svg)
    }

QRadioButton::indicator:checked {
    image:url(:/theme/radio_button_checked_#1a73e8ff_0.svg)
    }

QRadioButton::indicator:checked:disabled {
    image:url(:/theme/radio_button_checked_#4d515766_0.svg)
    }
    
PlotWidget {
    padding:0
    }
    
ParameterTree > .QWidget > .QWidget > .QWidget > QComboBox{
    min-height:1.2em
    }
    
ParameterTree::item,ParameterTree > .QWidget {
    background:rgba(248, 249, 250, 255);
    }
    

QCalendarWidget{
    leftarrow-icon:url(:/theme/arrow_upward_#4d5157ff_270.svg);
    rightarrow-icon:url(:/theme/arrow_upward_#4d5157ff_90.svg)
    }

QCommandLinkButton{
    qproperty-icon:url(:/theme/east_#4d5157ff_0.svg)
    }

QDockWidget,QMdiSubWindow{
    titlebar-close-icon:url(:/theme/close_#4d5157ff_0.svg);
    titlebar-normal-icon:url(:/theme/flip_to_front_#4d5157ff_0.svg)
    }

QFileDialog{
    backward-icon:url(:/theme/arrow_upward_#4d5157ff_270.svg);
    filedialog-detailedview-icon:url(:/theme/list_#4d5157ff_0.svg);
    filedialog-listview-icon:url(:/theme/grid_view_#4d5157ff_0.svg);
    filedialog-new-directory-icon:url(:/theme/create_new_folder_#4d5157ff_0.svg);
    filedialog-parent-directory-icon:url(:/theme/arrow_upward_#4d5157ff_0.svg);
    forward-icon:url(:/theme/arrow_upward_#4d5157ff_90.svg)
    }

QLineEdit{
    lineedit-clear-button-icon:url(:/theme/close_#4d5157ff_0.svg)
    }

QMdiSubWindow{
    titlebar-maximize-icon:url(:/theme/fullscreen_#4d5157ff_0.svg);
    titlebar-minimize-icon:url(:/theme/minimize_#4d5157ff_0.svg)
    }

QToolBarExtension{
    qproperty-icon:url(:/theme/double_arrow_#4d5157ff_0.svg)
    }
    